# Copy this file to .env.local and fill in your own Supabase project's values.
# Find both in: Supabase Dashboard -> Project Settings -> API
# The anon key is safe to expose in client code — it has no power on its
# own, every table it can touch is protected by Row Level Security.
# NEVER put the service_role key here or anywhere in this app.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional. Find yours in Sentry -> Settings -> Projects -> <project> -> Client Keys (DSN).
# Leave unset to disable Sentry entirely (main.tsx only calls Sentry.init() if this is set).
VITE_SENTRY_DSN=
